# --- Discord feed reader (discord_reader.py / discord_user_reader.py) ---
DISCORD_AUTH=bot                 # bot (Gateway) or user (read-only REST polling)
DISCORD_BOT_TOKEN=
DISCORD_USER_TOKEN=
DISCORD_POLL_SECONDS=15
DISCORD_CHANNEL_IDS=             # comma-separated; every other channel is ignored
DISCORD_HISTORY_LIMIT=0
DISCORD_MESSAGE_LOG=out/discord_messages.jsonl
LOG_LEVEL=INFO

# --- Alerts (pool_watch.py) ---
POOL_WEBHOOK_URL=                # where feed alerts are posted (comma list)
RESULTS_WEBHOOK_URL=off          # alert check-ins / results; off = log only
SCAN_WEBHOOK_URL=off             # busy-pool scanner alerts; off = log only
POOL_CLAUDE=1                    # Claude writes the setup for each alert
POOL_CLAUDE_MODEL=sonnet
CLAUDE_BIN=                      # default ~/.local/bin/claude

# --- AI trader (lp_trader.py) ---
LP_BOT_WEBHOOK_URL=              # where trader entries / closes / updates go
LP_TRADER_SIZE_SOL=1
LP_TRADER_MAX_OPEN=6
LP_TRADER_AI_MAX_CALLS=150
LP_TRADER_STATUS_HOURS=1
LP_TRADER_LIVE=                  # 1 = real money. Owner only, with LP_BOT_KEYPAIR below
LP_BOT_KEYPAIR=                  # path to a dedicated wallet's keypair JSON (never commit it)
LP_BOT_RPC_URL=
LP_BOT_LIVE_MAX_SOL=0.25
LP_BOT_RESERVE_SOL=0.1
LP_BOT_DAILY_LOSS_SOL=1.0
